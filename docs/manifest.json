    {
      "path": "CHANGELOG.md",
      "$comment": [
        "Append-only release history, so it is a RELEASE RECORD rather than an",
        "active document. Its entries were true for the release they describe:",
        "the v0.2.0 entry about validating 'the four shims' was accurate before",
        "v0.5 added the canonical ohmypm family and made the installed count",
        "eight. Treating the changelog as active would make the present-tense",
        "guards demand that such entries be rewritten to today's numbers, which",
        "would destroy exactly the release evidence they exist to preserve."
      ],
      "status": "release-record",
      "authority": "informative",
      "appliesTo": "all-releases",
      "replacement": null,
      "concern": "change-log"
    },
