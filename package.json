{
  "name": "oh-my-pm",
  "version": "0.6.2",
  "private": true,
  "description": "Local project intelligence system for structured project and product delivery.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:contracts": "node tools/gen-contracts.mjs",
    "build:kernel": "cargo build --workspace && node tools/build-kernel-wasm.mjs",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:fmt:check": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "quality": "pnpm lint && pnpm format:check && pnpm rust:fmt:check && pnpm rust:clippy",
    "test:unit": "vitest run --project unit",
    "test:integrity": "vitest run --project unit project-memory/test",
    "test:release": "vitest run --project release",
    "test:rust": "cargo test --workspace",
    "test": "pnpm test:unit && pnpm test:release && pnpm test:rust",
    "test:release:stress": "node tools/run-release-test-stress.mjs",
    "validate:public": "./tools/check-public-surface.sh",
    "validate:structure": "node tools/validate-structure.mjs",
    "validate:boundaries": "node tools/validate-boundaries.mjs",
    "validate:application": "node tools/validate-application-boundary.mjs",
    "validate:packages": "node tools/validate-packages.mjs",
    "validate:contracts": "node tools/validate-contracts.mjs",
    "version:check": "node tools/check-version-consistency.mjs",
    "validate:commands": "node tools/validate-command-surface.mjs",
    "validate:references": "node tools/validate-command-references.mjs",
    "validate:docs": "node tools/validate-doc-truth.mjs",
    "validate:action-pins": "node tools/validate-action-pins.mjs",
    "docs:inventory": "node tools/docs-inventory.mjs",
    "docs:inventory:check": "node tools/docs-inventory.mjs --strict",
    "validate": "pnpm validate:public && pnpm validate:structure && pnpm validate:boundaries && pnpm validate:application && pnpm validate:packages && pnpm validate:contracts && pnpm version:check && pnpm validate:commands && pnpm validate:references && pnpm validate:docs && pnpm docs:inventory:check && pnpm validate:action-pins",
    "mcp:smoke": "node tools/check-mcp-server.mjs",
    "local:install": "node tools/install-local.mjs",
    "local:check": "node tools/check-local-install.mjs",
    "mcp:config": "node tools/print-mcp-client-config.mjs",
    "release:preview": "node tools/build-release-bundle.mjs",
    "release:bundle": "node tools/build-release-bundle.mjs",
    "release:check": "node tools/check-release-bundle.mjs",
    "release:archives:preview": "node tools/build-release-archives.mjs",
    "release:archives": "node tools/build-release-archives.mjs",
    "release:archives:check": "node tools/check-release-archives.mjs",
    "release:archives:repro": "node tools/check-release-archive-reproducibility.mjs",
    "release:install": "node tools/install-release-bundle.mjs",
    "release:install:check": "node tools/check-release-install.mjs",
    "github:smoke": "node tools/check-github-provider-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@oh-my-pm/application": "workspace:*",
    "@oh-my-pm/cli": "workspace:*",
    "@oh-my-pm/mcp-server": "workspace:*",
    "@oh-my-pm/providers": "workspace:*",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "postcss": "^8.5.18"
    }
  }
}
